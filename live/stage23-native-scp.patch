diff --git a/src/scp/sbi-path.c b/src/scp/sbi-path.c
--- a/src/scp/sbi-path.c
+++ b/src/scp/sbi-path.c
@@
 #include "sbi-path.h"
+#include "third-party/cjson/cJSON.h"
+
+/*
+ * Stage 23 lab instrumentation.
+ *
+ * This code is compiled only in the disposable research image.  It has no
+ * network control surface and activates only when STAGE23_LAB_TAMPER=1 is
+ * present in the local process environment.  After a 30-response warm-up it
+ * changes nfStatus on every fifth eligible NRF discovery response immediately
+ * before the native SCP sends that response to its consumer.
+ */
+static void stage23_lab_instrument_response(ogs_sbi_response_t *response)
+{
+    static unsigned long eligible = 0;
+    const char *enabled = getenv("STAGE23_LAB_TAMPER");
+    cJSON *root = NULL, *instances = NULL, *profile = NULL, *status = NULL;
+    char *serialized = NULL;
+    char *owned = NULL;
+
+    if (!enabled || strcmp(enabled, "1") || !response ||
+        response->status != OGS_SBI_HTTP_STATUS_OK ||
+        !response->http.content || !response->http.content_length)
+        return;
+
+    root = cJSON_Parse(response->http.content);
+    if (!root)
+        return;
+
+    instances = cJSON_GetObjectItemCaseSensitive(root, "nfInstances");
+    if (!cJSON_IsArray(instances) || cJSON_GetArraySize(instances) < 1) {
+        cJSON_Delete(root);
+        return;
+    }
+
+    eligible++;
+    if (eligible <= 30 || ((eligible - 31) % 5) != 0) {
+        cJSON_Delete(root);
+        return;
+    }
+
+    profile = cJSON_GetArrayItem(instances, 0);
+    status = profile ?
+        cJSON_GetObjectItemCaseSensitive(profile, "nfStatus") : NULL;
+    if (!cJSON_IsString(status)) {
+        cJSON_Delete(root);
+        return;
+    }
+
+    cJSON_SetValuestring(status,
+        strcmp(status->valuestring, "SUSPENDED") ? "SUSPENDED" : "REGISTERED");
+
+    serialized = cJSON_PrintUnformatted(root);
+    cJSON_Delete(root);
+    if (!serialized)
+        return;
+
+    owned = ogs_strdup(serialized);
+    cJSON_free(serialized);
+    ogs_assert(owned);
+
+    ogs_free(response->http.content);
+    response->http.content = owned;
+    response->http.content_length = strlen(owned);
+    ogs_warn("STAGE23_NATIVE_SCP_LAB_MUTATION eligible=%lu", eligible);
+}
@@
 static int response_handler(
         int status, ogs_sbi_response_t *response, void *data)
@@
     if (assoc->nf_service_producer) {
@@
     }
+
+    stage23_lab_instrument_response(response);
 
     scp_assoc_remove(assoc);
